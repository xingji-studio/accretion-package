{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xingji-studio/accretion-package/schema/project.schema.json",
  "title": "Accretion Package project v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "app",
    "inputs",
    "applications"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "publisher": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "applications": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "string"
          },
          "linux": {
            "type": "string"
          },
          "xj380": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workingDirectory": {
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "compression": {
      "enum": [
        "lz4",
        "store"
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gui",
              "tui"
            ]
          }
        },
        "default": {
          "enum": [
            "gui",
            "tui",
            "auto"
          ]
        },
        "language": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "user",
            "machine"
          ]
        },
        "allowScopeChange": {
          "type": "boolean"
        },
        "allowPathChange": {
          "type": "boolean"
        },
        "paths": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "windows",
              "linux",
              "xj380"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "machine": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "installerIcon": {
          "type": "string"
        },
        "applicationIcon": {
          "type": "string"
        },
        "licenses": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "licenseText": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "#/$defs/id"
        },
        "launchDefault": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "include": {
          "$ref": "#/$defs/patterns"
        },
        "exclude": {
          "$ref": "#/$defs/patterns"
        },
        "preserve": {
          "$ref": "#/$defs/patterns"
        },
        "dereferenceInternalLinks": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "shortcuts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shortcut"
      }
    },
    "registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registry"
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/association"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "windows-x64",
          "linux-x64",
          "xj380-x64"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "destination": {
          "type": "string"
        },
        "defaultChecked": {
          "type": "boolean",
          "default": true
        },
        "required": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "id",
        "name",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "set",
            "setIfMissing",
            "appendUnique",
            "prependUnique"
          ]
        },
        "scope": {
          "enum": [
            "inherit",
            "application",
            "user",
            "machine"
          ]
        },
        "defaultChecked": {
          "type": "boolean",
          "default": true
        },
        "component": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "shortcut": {
      "type": "object",
      "required": [
        "id",
        "application"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "application": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "enum": [
            "desktop",
            "menu"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "type": "string"
        },
        "terminal": {
          "type": "boolean"
        },
        "defaultChecked": {
          "type": "boolean",
          "default": true
        },
        "component": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "required": [
        "id",
        "key",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "expandString",
            "dword"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer"
          ]
        },
        "scope": {
          "enum": [
            "inherit",
            "user",
            "machine"
          ]
        }
      },
      "additionalProperties": false
    },
    "association": {
      "type": "object",
      "required": [
        "id",
        "application",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "application": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9_-]+$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
