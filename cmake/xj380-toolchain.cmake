set(CMAKE_SYSTEM_NAME XJ380)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(AP_XJ_FLAGS "--target=x86_64-unknown-none-elf -ffreestanding -fno-pic -fno-pie -fno-stack-protector -mno-red-zone")
set(CMAKE_C_FLAGS_INIT "${AP_XJ_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${AP_XJ_FLAGS} -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "--target=x86_64-unknown-none-elf")
